# Másters sin comprimir: se quedan en tu equipo, no se suben al repo.
# La web usa las versiones optimizadas videos/proyectoN.mp4
videos/originales/

# Archivos temporales de compresión
videos/*_src.mp4
videos/test5s*.mp4

# Archivos generados por editores/IDE
.Rhistory
.Rproj.user/
.DS_Store
Thumbs.db

# ==================== SECRETOS ====================
# Nunca subas claves ni credenciales al repositorio: este repo es PÚBLICO.
# Si algún día agregas un servicio que necesite una clave, guárdala en un
# archivo .env local (o en las variables de entorno de tu hosting), nunca
# escrita dentro de index.html o script.js.
.env
.env.*
*.key
*.pem
*.p12
*.pfx
id_rsa
id_rsa.*
credentials.json
secrets.json
config.local.js
*.credentials
.netrc
.npmrc
.aws/
.ssh/
